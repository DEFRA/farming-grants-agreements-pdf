{
  "name": "farming-grants-agreements-pdf",
  "version": "0.0.0",
  "description": "farming-grants-agreements-pdf",
  "main": ".server/index.js",
  "type": "module",
  "imports": {
    "#~/*": "./src/*"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development npm run server:watch",
    "dev:debug": "NODE_ENV=development npm run server:debug",
    "docker:dev": "NODE_ENV=development npm run server:watch",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "git:pre-commit-hook": "npm run format:check && npm run lint && npm run test",
    "commitlint": "commitlint --edit",
    "lint": "npm run lint:eslint && npm run lint:knip",
    "lint:eslint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:knip": "knip",
    "lint:fix": "npm run lint:eslint -- --fix && npm run lint:knip -- --fix",
    "postinstall": "npm run setup:husky",
    "server:debug": "nodemon --exec tsx --enable-source-maps --inspect ./src",
    "server:watch": "nodemon --exec tsx --enable-source-maps ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node --use-strict .",
    "test": "vitest run --exclude '**/contracts/**' --exclude '**/functional/**' --coverage --reporter=verbose",
    "test:watch": "vitest --exclude '**/contracts/**' --exclude '**/functional/**'",
    "test:functional": "vitest run --config vitest.functional.config.js",
    "test:contracts": "vitest run src/contracts",
    "test:contracts:consumer": "vitest run src/contracts/consumer",
    "test:contracts:provider": "echo 'No provider contract tests to run'"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/client-sns": "3.1101.0",
    "@aws-sdk/client-sqs": "3.1101.0",
    "@aws-sdk/credential-providers": "3.1101.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.10",
    "@hapi/jwt": "3.2.4",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "date-fns": "4.4.0",
    "global-agent": "3.0.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "pino": "9.13.1",
    "pino-pretty": "13.0.0",
    "puppeteer": "24.18.0",
    "sqs-consumer": "13.0.0",
    "undici": "8.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@pact-foundation/pact": "17.1.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "knip": "6.31.0",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^5.6.3",
    "vitest": "4.1.10"
  }
}
